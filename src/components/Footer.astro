
---
const currentYear = new Date().getFullYear();

const quickLinks = [
  { label: "Home", href: "#top" },
  { label: "Our Services", href: "#services" },
  { label: "Why BrightNest", href: "#why-brightnest" },
  { label: "Reviews", href: "#reviews" },
  { label: "Contact", href: "#contact" },
];

const serviceLinks = [
  { label: "Standard Home Cleaning", href: "#services" },
  { label: "Deep Cleaning", href: "#services" },
  { label: "Move-In / Move-Out", href: "#services" },
];
---

<footer class="bg-brand-forest text-white">
  <div class="mx-auto max-w-7xl px-5 pb-6 pt-14 sm:px-8 sm:pt-16">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr] lg:gap-12">
      <!-- Brand -->
      <div>
        <a
          href="#top"
          class="inline-flex items-center gap-3 rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-sage"
          aria-label="BrightNest Cleaning Co. — back to top"
        >
          <span class="flex size-11 items-center justify-center rounded-2xl bg-brand-sage text-brand-forest">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              class="size-6"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1V10Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="m8 7 4-3 4 3" />
            </svg>
          </span>

          <span>
            <span class="block text-lg font-bold tracking-tight">
              BrightNest
            </span>
            <span class="block text-xs font-medium tracking-[0.15em] text-brand-sage">
              CLEANING CO.
            </span>
          </span>
        </a>

        <p class="mt-5 max-w-sm text-sm leading-7 text-white/75">
          A fresh, thoughtful approach to a cleaner home. Explore our cleaning
          services and get in touch to discuss your needs.
        </p>

        <a
          href="#contact"
          class="mt-6 inline-flex items-center gap-2 rounded-full bg-brand-sage px-5 py-3 text-sm font-semibold text-brand-forest transition hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
        >
          Contact us
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="size-4"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" />
          </svg>
        </a>
      </div>

      <!-- Quick links -->
      <nav aria-label="Footer navigation">
        <h2 class="text-sm font-bold uppercase tracking-[0.15em] text-brand-sage">
          Explore
        </h2>

        <ul class="mt-5 space-y-3">
          {quickLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="inline-block rounded-sm text-sm text-white/75 transition hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-sage"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Services -->
      <nav aria-label="Cleaning services">
        <h2 class="text-sm font-bold uppercase tracking-[0.15em] text-brand-sage">
          Our services
        </h2>

        <ul class="mt-5 space-y-3">
          {serviceLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="inline-block rounded-sm text-sm text-white/75 transition hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-sage"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Contact prompt -->
      <div>
        <h2 class="text-sm font-bold uppercase tracking-[0.15em] text-brand-sage">
          Let's connect
        </h2>

        <p class="mt-5 text-sm leading-7 text-white/75">
          Have a question or need help choosing a service? Start with our
          contact form.
        </p>

        <a
          href="#contact"
          class="mt-4 inline-flex items-center gap-2 rounded-sm text-sm font-semibold text-white underline decoration-brand-sage underline-offset-4 transition hover:text-brand-sage focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-sage"
        >
          Go to contact form
          <span aria-hidden="true">↗</span>
        </a>

        <p class="mt-5 text-xs leading-5 text-white/55">
          Austin, Texas — demo service area. Confirm actual coverage before launch.
        </p>
      </div>
    </div>

    <div class="mt-12 border-t border-white/15 pt-6 sm:mt-14">
      <div class="flex flex-col gap-3 text-xs leading-5 text-white/60 sm:flex-row sm:items-center sm:justify-between">
        <p>
          © {currentYear} BrightNest Cleaning Co. All rights reserved.
        </p>

        <a
          href="#top"
          class="inline-flex w-fit items-center gap-2 rounded-sm transition hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-sage"
        >
          Back to top
          <span aria-hidden="true">↑</span>
        </a>
      </div>

      <p class="mt-4 text-xs leading-5 text-white/50">
        Demo website. Replace sample content and verify business information before publishing for a real client.
      </p>
    </div>
  </div>
</footer>
