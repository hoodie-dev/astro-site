
---
interface Props {
  title: string;
  description: string;
  icon: "house" | "sparkles" | "key";
  number: string;
}

const { title, description, icon, number } = Astro.props;
---

<article
  class="group flex h-full flex-col rounded-2xl border border-brand-forest/10 bg-white p-6 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-brand-forest/20 hover:shadow-lg sm:p-8"
>
  <div class="flex items-start justify-between gap-4">
    <span
      class="flex size-14 shrink-0 items-center justify-center rounded-2xl bg-brand-sage text-brand-forest transition-colors duration-300 group-hover:bg-brand-forest group-hover:text-white"
    >
      {icon === "house" && (
        <svg
          viewBox="0 0 24 24"
          class="size-7"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m3 10 9-7 9 7" />
          <path d="M5 9v12h14V9" />
          <path d="M9 21v-7h6v7" />
        </svg>
      )}

      {icon === "sparkles" && (
        <svg
          viewBox="0 0 24 24"
          class="size-7"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m12 3 1.9 5.8L20 11l-6.1 2.2L12 19l-2-5.8L4 11l6-2.2L12 3Z" />
          <path d="m19 14 1.1 2.9L23 18l-2.9 1.1L19 22l-1.1-2.9L15 18l2.9-1.1L19 14Z" />
          <path d="m5 2 .8 2.2L8 5l-2.2.8L5 8l-.8-2.2L2 5l2.2-.8L5 2Z" />
        </svg>
      )}

      {icon === "key" && (
        <svg
          viewBox="0 0 24 24"
          class="size-7"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="8" cy="15" r="5" />
          <path d="m11.5 11.5 8-8L22 6l-3 3 2 2-3 3-2-2-3 3" />
        </svg>
      )}
    </span>

    <span class="text-sm font-semibold tracking-widest text-brand-forest/40">
      {number}
    </span>
  </div>

  <h3
    class="mt-7 text-xl font-bold tracking-tight text-brand-forest sm:text-2xl"
  >
    {title}
  </h3>

  <p class="mt-3 flex-1 text-sm leading-7 text-brand-muted sm:text-base">
    {description}
  </p>

  <a
    href="#contact"
    class="mt-6 inline-flex min-h-11 w-fit items-center gap-2 rounded-sm text-sm font-semibold text-brand-forest focus-visible:outline-offset-4"
  >
    Ask about this service
    <svg
      viewBox="0 0 20 20"
      class="size-4 transition-transform duration-200 group-hover:translate-x-1"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M4 10h12M10 4l6 6-6 6" />
    </svg>
  </a>
</article>
