
---
const services = [
  "Standard Home Cleaning",
  "Deep Cleaning",
  "Move-In / Move-Out Cleaning",
  "I'm not sure yet",
];
---

<section id="contact" class="scroll-mt-24 bg-brand-cream px-5 py-20 sm:px-8 lg:py-28">
  <div class="mx-auto max-w-7xl">
    <div class="mx-auto mb-12 max-w-2xl text-center">
      <p class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-brand-forest">
        Get in touch
      </p>

      <h2 class="text-3xl font-bold tracking-tight text-brand-ink sm:text-4xl lg:text-5xl">
        Let's make your home feel fresh.
      </h2>

      <p class="mt-5 text-base leading-7 text-brand-muted sm:text-lg">
        Tell us a little about your space and the cleaning help you're looking
        for. We'll use these details to plan the next step.
      </p>
    </div>

    <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:gap-12">
      <!-- Contact information -->
      <aside class="flex flex-col rounded-3xl bg-brand-forest p-7 text-white sm:p-9">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-brand-sage">
          Contact BrightNest
        </p>

        <h3 class="mt-4 text-2xl font-bold sm:text-3xl">
          A little help goes a long way.
        </h3>

        <p class="mt-4 leading-7 text-white/80">
          Have a question about our services? Send us a message using the form
          and tell us what your home needs.
        </p>

        <div class="mt-9 space-y-6">
          <div class="flex items-start gap-4">
            <span aria-hidden="true" class="flex size-11 shrink-0 items-center justify-center rounded-full bg-white/10 text-brand-sage">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" />
                <circle cx="12" cy="10" r="2.5" />
              </svg>
            </span>
            <div>
              <h4 class="font-semibold">Service area</h4>
              <p class="mt-1 text-sm leading-6 text-white/75">
                Austin, Texas
              </p>
              <p class="text-xs text-brand-sage">
                Demo business location — confirm actual coverage before launch.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <span aria-hidden="true" class="flex size-11 shrink-0 items-center justify-center rounded-full bg-white/10 text-brand-sage">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-5">
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path stroke-linecap="round" stroke-linejoin="round" d="m4 7 8 6 8-6" />
              </svg>
            </span>
            <div>
              <h4 class="font-semibold">Email</h4>
              <p class="mt-1 text-sm leading-6 text-white/75">
                Add the business's verified email address
              </p>
              <p class="text-xs text-brand-sage">
                Placeholder — not a working contact address.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <span aria-hidden="true" class="flex size-11 shrink-0 items-center justify-center rounded-full bg-white/10 text-brand-sage">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-5">
                <circle cx="12" cy="12" r="9" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3 2" />
              </svg>
            </span>
            <div>
              <h4 class="font-semibold">Availability</h4>
              <p class="mt-1 text-sm leading-6 text-white/75">
                Add confirmed business hours here.
              </p>
              <p class="text-xs text-brand-sage">
                Placeholder — hours have not been verified.
              </p>
            </div>
          </div>
        </div>

        <div class="mt-auto pt-10">
          <p class="rounded-2xl border border-white/20 bg-white/5 p-4 text-sm leading-6 text-white/80">
            <strong class="text-white">Website demo:</strong>
            Replace all placeholder business details with verified information
            before publishing for a real business.
          </p>
        </div>
      </aside>

      <!-- Contact form -->
      <div class="rounded-3xl border border-brand-sage/70 bg-white p-6 shadow-sm sm:p-9">
        <div class="mb-7">
          <h3 class="text-2xl font-bold text-brand-ink">Tell us what you need</h3>
          <p class="mt-2 text-sm leading-6 text-brand-muted">
            Fields marked with * are required.
          </p>
        </div>

        <form id="contact-form" class="space-y-5">
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="contact-name" class="mb-2 block text-sm font-semibold text-brand-ink">
                Full name *
              </label>
              <input
                id="contact-name"
                name="name"
                type="text"
                autocomplete="name"
                placeholder="Your name"
                required
                minlength="2"
                maxlength="80"
                class="w-full rounded-xl border border-brand-sage bg-brand-cream/40 px-4 py-3 text-brand-ink placeholder:text-brand-muted/80 outline-none transition focus:border-brand-forest focus:ring-2 focus:ring-brand-sage"
              />
            </div>

            <div>
              <label for="contact-email" class="mb-2 block text-sm font-semibold text-brand-ink">
                Email address *
              </label>
              <input
                id="contact-email"
                name="email"
                type="email"
                autocomplete="email"
                placeholder="you@example.com"
                required
                maxlength="254"
                class="w-full rounded-xl border border-brand-sage bg-brand-cream/40 px-4 py-3 text-brand-ink placeholder:text-brand-muted/80 outline-none transition focus:border-brand-forest focus:ring-2 focus:ring-brand-sage"
              />
            </div>
          </div>

          <div>
            <label for="contact-service" class="mb-2 block text-sm font-semibold text-brand-ink">
              Which service are you interested in? *
            </label>
            <select
              id="contact-service"
              name="service"
              required
              class="w-full rounded-xl border border-brand-sage bg-brand-cream/40 px-4 py-3 text-brand-ink outline-none transition focus:border-brand-forest focus:ring-2 focus:ring-brand-sage"
            >
              <option value="" disabled selected>Select a service</option>
              {services.map((service) => (
                <option value={service}>{service}</option>
              ))}
            </select>
          </div>

          <div>
            <label for="contact-message" class="mb-2 block text-sm font-semibold text-brand-ink">
              How can we help? *
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="5"
              required
              minlength="10"
              maxlength="2000"
              placeholder="Tell us about your home and what you'd like cleaned..."
              class="w-full resize-y rounded-xl border border-brand-sage bg-brand-cream/40 px-4 py-3 text-brand-ink placeholder:text-brand-muted/80 outline-none transition focus:border-brand-forest focus:ring-2 focus:ring-brand-sage"
            ></textarea>
            <p class="mt-2 text-xs leading-5 text-brand-muted">
              Please don't include payment details or other sensitive information.
            </p>
          </div>

          <button
            type="submit"
            class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-brand-forest px-6 py-3.5 font-semibold text-white transition hover:bg-brand-forest-dark focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-forest sm:w-auto"
          >
            Validate demo enquiry
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" />
            </svg>
          </button>

          <p
            id="contact-form-status"
            role="status"
            aria-live="polite"
            class="hidden rounded-xl border border-brand-sage bg-brand-cream p-4 text-sm leading-6 text-brand-ink"
          ></p>

          <p class="text-xs leading-5 text-brand-muted">
            Demo only: this form currently validates your entries in the browser.
            It does not send or store your message.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const status = document.querySelector<HTMLParagraphElement>(
    "#contact-form-status",
  );

  form?.addEventListener("submit", (event) => {
    // Native browser validation runs before this submit event.
    event.preventDefault();

    if (!status) return;

    status.textContent =
      "Validation successful! This is a demo only, so your message has not been sent. Connect a form service before using this website for real enquiries.";
    status.classList.remove("hidden");
  });
</script>
