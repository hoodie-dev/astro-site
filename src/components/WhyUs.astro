
---
const benefits = [
  {
    number: "01",
    title: "Attention to detail",
    description:
      "A thoughtful approach to the everyday details that help a space feel clean, comfortable, and welcoming.",
  },
  {
    number: "02",
    title: "Your home comes first",
    description:
      "Cleaning options that take your home's needs and your priorities into consideration.",
  },
  {
    number: "03",
    title: "Options that fit",
    description:
      "From routine upkeep to a deeper clean, explore an option that suits your space and schedule.",
  },
  {
    number: "04",
    title: "Clear communication",
    description:
      "Know what to expect, discuss your needs, and make an informed choice before booking.",
  },
];
---

<section
  id="why-brightnest"
  aria-labelledby="why-title"
  class="scroll-mt-24 bg-brand-cream px-5 py-20 sm:px-8 sm:py-24 lg:px-10 lg:py-28"
>
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:gap-16">

      <!-- Left: Brand message -->
      <div class="relative overflow-hidden rounded-3xl bg-brand-forest p-7 text-white sm:p-10 lg:p-12">
        <div
          aria-hidden="true"
          class="absolute -right-16 -top-16 size-48 rounded-full border border-white/10 sm:size-64"
        ></div>

        <div
          aria-hidden="true"
          class="absolute -right-8 -top-8 size-32 rounded-full border border-white/10 sm:size-44"
        ></div>

        <div class="relative">
          <p class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.2em] text-brand-sage sm:text-sm">
            <span class="size-2 rounded-full bg-brand-sage"></span>
            The BrightNest difference
          </p>

          <h2
            id="why-title"
            class="mt-6 text-3xl font-bold leading-tight tracking-tight sm:text-4xl lg:text-5xl"
          >
            A little more care.
            <span class="text-brand-sage">A lot more comfort.</span>
          </h2>

          <p class="mt-6 max-w-lg text-base leading-7 text-white/75 sm:text-lg sm:leading-8">
            Your home is where life happens. Our approach starts with
            understanding what your space needs and helping you find the
            right cleaning option.
          </p>

          <a
            href="#contact"
            class="mt-8 inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-white px-6 py-3 text-sm font-semibold text-brand-forest transition hover:bg-brand-sage focus-visible:outline-offset-4"
          >
            Let's Talk About Your Home
            <svg
              aria-hidden="true"
              viewBox="0 0 20 20"
              class="size-4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M4 10h12M10 4l6 6-6 6" />
            </svg>
          </a>

          <p class="mt-8 border-t border-white/15 pt-5 text-sm text-white/65">
            Thoughtful cleaning for homes in Austin, Texas.
          </p>
        </div>
      </div>

      <!-- Right: Benefits list -->
      <div>
        <div class="mb-8 max-w-xl">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-forest sm:text-sm">
            What matters to us
          </p>

          <h3 class="mt-3 text-2xl font-bold tracking-tight text-brand-forest sm:text-3xl">
            The details make the difference.
          </h3>

          <p class="mt-4 leading-7 text-brand-muted">
            Choosing a cleaning service should feel straightforward. Here's
            what we'd like every BrightNest customer to expect.
          </p>
        </div>

        <div class="grid gap-0 sm:grid-cols-2 sm:gap-x-6">
          {benefits.map((benefit) => (
            <article class="border-t border-brand-forest/15 py-6">
              <div class="flex items-center gap-3">
                <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-brand-sage text-sm font-bold text-brand-forest">
                  {benefit.number}
                </span>

                <h4 class="text-base font-bold text-brand-forest sm:text-lg">
                  {benefit.title}
                </h4>
              </div>

              <p class="mt-3 text-sm leading-7 text-brand-muted">
                {benefit.description}
              </p>
            </article>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
