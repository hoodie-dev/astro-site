
---
---

<section
  aria-labelledby="hero-title"
  class="overflow-hidden bg-brand-cream"
>
  <div
    class="mx-auto grid max-w-7xl items-center gap-12 px-5 py-14 sm:px-8 sm:py-20 lg:grid-cols-2 lg:gap-16 lg:px-10 lg:py-24"
  >
    <!-- Left: Copy and calls to action -->
    <div class="relative z-10">
      <p
        class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand-forest/15 bg-white/70 px-4 py-2 text-xs font-semibold uppercase tracking-[0.16em] text-brand-forest sm:text-sm"
      >
        <span class="size-2 rounded-full bg-brand-forest"></span>
        A brighter kind of clean
      </p>

      <h1
        id="hero-title"
        class="max-w-2xl text-4xl font-bold leading-[1.1] tracking-tight text-brand-forest sm:text-5xl lg:text-6xl xl:text-7xl"
      >
        Come home to a space that
        <span class="relative inline-block">
          feels fresh.
          <span
            aria-hidden="true"
            class="absolute -bottom-1 left-0 -z-0 h-2 w-full rounded-full bg-brand-sage sm:h-3"
          ></span>
        </span>
      </h1>

      <p
        class="mt-7 max-w-xl text-base leading-7 text-brand-muted sm:text-lg sm:leading-8"
      >
        Thoughtful home cleaning for a more comfortable, welcoming space.
        Spend less time worrying about chores and more time enjoying home.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href="#contact"
          class="inline-flex min-h-13 items-center justify-center gap-2 rounded-full bg-brand-forest px-7 py-4 text-sm font-semibold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-brand-forest-dark focus-visible:outline-offset-4"
        >
          Get a Free Quote
          <svg
            aria-hidden="true"
            viewBox="0 0 20 20"
            class="size-4"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path d="M4 10h12M10 4l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>

        <a
          href="#services"
          class="inline-flex min-h-13 items-center justify-center rounded-full border border-brand-forest/20 px-7 py-4 text-sm font-semibold text-brand-forest transition hover:bg-brand-sage"
        >
          Explore Our Services
        </a>
      </div>

      <!-- Service area -->
      <div class="mt-9 flex items-start gap-3 border-t border-brand-forest/10 pt-6">
        <span
          class="flex size-10 shrink-0 items-center justify-center rounded-full bg-brand-sage text-brand-forest"
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            class="size-5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z" />
            <circle cx="12" cy="10" r="2.5" />
          </svg>
        </span>

        <div>
          <p class="text-sm font-semibold text-brand-ink">
            Proud to serve Austin, Texas
          </p>
          <p class="mt-1 text-sm leading-6 text-brand-muted">
            A welcoming home starts with a little extra care.
          </p>
        </div>
      </div>
    </div>

    <!-- Right: Lifestyle image -->
    <div class="relative mx-auto w-full max-w-xl lg:max-w-none">
      <div
        aria-hidden="true"
        class="absolute -right-4 -top-4 size-28 rounded-full bg-brand-sage/80 sm:-right-6 sm:-top-6 sm:size-36"
      ></div>

      <div
        class="relative aspect-[4/5] overflow-hidden rounded-[2rem] bg-brand-sage shadow-xl sm:rounded-[2.5rem]"
      >
        <img
          src="https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=1200&q=85"
          alt="Bright, thoughtfully styled living room with comfortable furniture and natural textures"
          class="h-full w-full object-cover"
          width="1200"
          height="1500"
          fetchpriority="high"
        />

        <div
          aria-hidden="true"
          class="absolute inset-0 bg-gradient-to-t from-brand-forest/35 via-transparent to-transparent"
        ></div>

        <div
          class="absolute bottom-5 left-5 right-5 rounded-2xl border border-white/50 bg-white/90 p-4 shadow-lg backdrop-blur-sm sm:bottom-7 sm:left-7 sm:right-7 sm:p-5"
        >
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brand-muted">
            Your home, refreshed
          </p>
          <p class="mt-2 text-lg font-bold tracking-tight text-brand-forest sm:text-xl">
            More comfort. Less chore time.
          </p>
        </div>
      </div>

      <div
        aria-hidden="true"
        class="absolute -bottom-5 -left-4 -z-0 size-20 rounded-full border border-brand-forest/15 sm:-bottom-7 sm:-left-6 sm:size-28"
      ></div>
    </div>
  </div>
</section>
